# Supabase — rankings storage (create a free project at supabase.com and run
# supabase/migrations/0001_rankings.sql in its SQL editor)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Any passphrase you choose — required in the "Upload key" field when
# publishing rankings from the /rankings page
RANKINGS_UPLOAD_KEY=

# Later, for the Stripe paywall:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
